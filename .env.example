# ============================================================
# THENIJOBS — Environment Configuration Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git. NEVER share secrets.
# ============================================================

# ── Razorpay Payment Gateway ────────────────────────────────
# Public key (safe for browser) — used by Razorpay Checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=[REDACTED]
# Server-only key ID (same value, but NOT prefixed with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=[REDACTED]
# Server-only secret — NEVER expose in frontend / NEXT_PUBLIC_*
RAZORPAY_KEY_SECRET=[REDACTED]
# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# Used by seeker-public-profile/webhook and ai/connections/fee/webhook
RAZORPAY_WEBHOOK_SECRET=[REDACTED]

# ── Cron Job Authorization ──────────────────────────────────
# Used by /api/cron/* routes. Generate with: openssl rand -base64 32
# Set the SAME value in Vercel Environment Variables
CRON_SECRET=[REDACTED]

# ── Firebase Client Configuration (public, safe for browser) ─
NEXT_PUBLIC_FIREBASE_API_KEY=[REDACTED]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=[REDACTED].firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=[REDACTED]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=[REDACTED].firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=[REDACTED]
NEXT_PUBLIC_FIREBASE_APP_ID=[REDACTED]
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=[REDACTED]
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://[REDACTED]-default-rtdb.firebaseio.com

# ── Firebase Admin SDK (server-only, NEVER prefix with NEXT_PUBLIC_) ─
# Download from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → paste the ENTIRE JSON as one line
FIREBASE_SERVICE_ACCOUNT_KEY=[REDACTED — full JSON key object]

# ── AI Key Encryption (server-only) ─────────────────────────
# Used to encrypt/decrypt BYOK user API keys at rest in Firestore.
# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes for AES-256-GCM
AI_KEY_ENCRYPTION_SECRET=[REDACTED]

# ── AI Provider Keys (server-only, optional) ────────────────
# Platform-level AI keys for Groq/OpenAI/Gemini providers.
# Set in platformSettings/aiConfig via the admin panel, OR here as fallbacks.
# GROQ_API_KEY=[REDACTED]
# OPENAI_API_KEY=[REDACTED]
# GEMINI_API_KEY=[REDACTED]
