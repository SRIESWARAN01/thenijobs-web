rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isCompanyOwner(companyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isEmployerOrOwner() {
      return isAuthenticated() && getUserRole() in ['employer', 'business_owner'];
    }

    // ── Moderation field guards ───────────────────────────────────────────────
    function safeCompanyCreate() {
      let d = request.resource.data;
      return
        (!d.keys().hasAny(['verificationStatus']) || d.verificationStatus == 'pending') &&
        (!d.keys().hasAny(['isActive'])           || d.isActive == false) &&
        (!d.keys().hasAny(['isVerified'])          || d.isVerified == false) &&
        (!d.keys().hasAny(['isFeatured'])          || d.isFeatured == false) &&
        (!d.keys().hasAny(['rejectionReason'])     || d.rejectionReason == '');
    }

    function safeJobCreate() {
      let d = request.resource.data;
      return
        // RULES-1: 'draft' is the employer's duplicate-as-draft; both are inactive until admin approval
        (!d.keys().hasAny(['status'])          || d.status in ['pending', 'draft']) &&
        (!d.keys().hasAny(['isActive'])         || d.isActive == false) &&
        (!d.keys().hasAny(['isFeatured'])       || d.isFeatured == false) &&
        (!d.keys().hasAny(['rejectionReason'])  || d.rejectionReason == '');
    }

    function companyModerationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'verificationStatus', 'isActive', 'isVerified', 'isFeatured',
        'isPremium', 'rejectionReason',
        // RULES-1: plan and ownership fields are admin/server-owned (security.md S-3)
        'subscriptionPlan', 'planStartDate', 'planEndDate', 'ownerId'
      ]);
    }

    // RULES-1: an owner may re-submit a REJECTED company for review (become-employer flow):
    // rejected → pending, still inactive and unverified, and no other moderated/plan field moves.
    function companyOwnerResubmission() {
      let d = request.resource.data;
      return resource.data.verificationStatus == 'rejected' &&
        d.verificationStatus == 'pending' &&
        (!d.keys().hasAny(['isActive'])   || d.isActive == false) &&
        (!d.keys().hasAny(['isVerified']) || d.isVerified == false) &&
        !d.diff(resource.data).affectedKeys().hasAny([
          'isFeatured', 'isPremium', 'rejectionReason',
          'subscriptionPlan', 'planStartDate', 'planEndDate', 'ownerId'
        ]);
    }

    function jobModerationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status', 'isActive', 'isFeatured', 'rejectionReason'
      ]);
    }

    function userModerationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isVerified', 'adminRole', 'employerRole',
        // RULES-1: credits, plan and employer-grant fields are admin/server-owned (security.md S-3)
        'aiCredits', 'aiCreditsUsed', 'companyId', 'isEmployer', 'canPostJobs',
        'subscriptionPlan', 'isPremium'
      ]);
    }

    // RULES-2: who a conversation is BETWEEN is not something a participant may edit.
    //
    // `update` allowed a participant, the seeker, the company owner or an admin to rewrite the
    // document freely — `participants`, `seekerId` and `companyId` included. Changing
    // `companyId` makes a different employer pass `isCompanyOwner()` in the READ rule above, so
    // a stranger gains the whole thread; rewriting `participants` drops the other party or adds
    // someone who was never in it.
    //
    // This is deliberately a diff test and not a `hasOnly` whitelist of writable fields.
    // `applyToJob` writes the thread with `setDoc(..., { merge: true })` on a deterministic
    // chatId, so a repeat application is an UPDATE carrying every field, and a whitelist would
    // deny it. `affectedKeys()` reports only keys whose value actually changed, so re-writing
    // identical values passes and a real membership edit does not.
    function conversationMembershipUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'participants', 'seekerId', 'companyId', 'applicationId', 'id'
      ]);
    }

    // SEC-2: the same membership test the conversation READ rule already used, named once so
    // the messages subcollection can reuse it for create instead of accepting anyone signed in.
    // The company-owner arm matters: threads created before FIX-1 hold a company document id in
    // `participants` rather than the owner's uid, so an employer reaches those only this way.
    function mayUseConversation(chatId) {
      let c = get(/databases/$(database)/documents/conversations/$(chatId)).data;
      return isAuthenticated() && (
        request.auth.uid in c.participants ||
        c.seekerId == request.auth.uid ||
        isCompanyOwner(c.companyId) ||
        isAdmin()
      );
    }

    // FIX-2: a job seeker may notify a company owner, but only about an application they
    // themselves made. Nothing here is taken on trust from the request: the application
    // document proves who applied and to which company, and the company document proves who
    // owns it. Field presence is checked first so && short-circuits before any get(), which
    // keeps this branch free for every other kind of notification.
    function seekerAlertingOwnApplicationsCompany() {
      let d = request.resource.data;
      return d.keys().hasAll(['userId', 'type', 'title', 'message', 'companyId', 'applicationId']) &&
        d.type == 'application_update' &&
        get(/databases/$(database)/documents/applications/$(d.applicationId)).data.seekerId == request.auth.uid &&
        get(/databases/$(database)/documents/applications/$(d.applicationId)).data.companyId == d.companyId &&
        get(/databases/$(database)/documents/companies/$(d.companyId)).data.ownerId == d.userId;
    }

    // RULES-1 (D-JOBSTATE): a poster may deactivate their own job (pause, close) or send it back
    // for moderation (pending). Activation stays admin-only. Such a write may touch only these keys.
    function jobPosterDeactivation() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive', 'archived', 'updatedAt']) &&
        d.status in ['paused', 'closed', 'pending'] &&
        d.isActive == false;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) &&
        request.resource.data.role in ['job_seeker', 'employer', 'business_owner', 'supplier', 'service_provider']) || isAdmin();
      allow update: if (isOwner(userId) && userModerationUnchanged()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== COMPANIES =====
    match /companies/{companyId} {
      // H2 FIX: Allow public read if verified OR if isActive — aligns with frontend queries
      allow read: if resource.data.verificationStatus == 'verified' ||
        resource.data.isActive == true ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if (isAuthenticated() && safeCompanyCreate() &&
        request.resource.data.ownerId == request.auth.uid) || isAdmin();
      allow update: if
        (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
          (companyModerationUnchanged() || companyOwnerResubmission())) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ===== JOBS =====
    match /jobs/{jobId} {
      // H3 FIX: Allow public read for multiple valid status values — aligns with admin workflows
      //
      // RULES-4: `isCompanyOwner(...)` is not decoration. Without it, deploying this file breaks
      // every employer's job list. A LIST query has to be provably safe from its own
      // constraints, and NO query in this application filters on `postedBy` — employer/jobs,
      // employer/dashboard and employer/post-job all filter on `companyId`. So a query that
      // could return a draft or pending job could not be shown safe against the `postedBy`
      // clause, and Firestore refuses the whole query rather than filtering it. An emulator
      // probe on the previous version of this rule denied exactly those screens' queries.
      //
      // This is not a new policy: applications, interviews, leads and conversations already
      // authorise the employer side with isCompanyOwner(resource.data.companyId). jobs was the
      // only collection that did not, and the queries were written for the policy the rest of
      // the file uses.
      //
      // Order matters. The two comparisons above cost nothing; isCompanyOwner() and isAdmin()
      // each spend one of the ten document reads a rule evaluation is allowed, so they come
      // last and the common paths never reach them.
      allow read: if resource.data.status in ['active', 'APPROVED', 'LIVE'] ||
        (isAuthenticated() && resource.data.postedBy == request.auth.uid) ||
        isCompanyOwner(resource.data.companyId) || isAdmin();
      allow create: if (isAuthenticated() && safeJobCreate() &&
        request.resource.data.postedBy == request.auth.uid) || isAdmin();
      allow update: if
        (isAuthenticated() && resource.data.postedBy == request.auth.uid &&
          (jobModerationUnchanged() || jobPosterDeactivation())) ||
        isAdmin();
      allow delete: if
        (isAuthenticated() && resource.data.postedBy == request.auth.uid) ||
        isAdmin();
    }

    // ===== JOB APPLICATIONS =====
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      // P0 FIX: seekerId must match the authenticated user — prevents impersonation
      allow create: if isAuthenticated() &&
        request.resource.data.seekerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['seekerId', 'jobId', 'companyId']);
      // Seeker can withdraw; employer (company owner) can update status
      allow update: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      ) &&
      // Seeker cannot change companyId/jobId/seekerId after submission
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seekerId', 'jobId', 'companyId']);
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.seekerId == request.auth.uid);
    }

    // ===== REVIEWS =====
    match /reviews/{reviewId} {
      allow read: if true;
      // P0 FIX: reviewerId must match authenticated user
      allow create: if isAuthenticated() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['reviewerId', 'companyId', 'rating']);
      allow update: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin()) &&
        // Cannot change companyId or reviewerId after posting
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewerId', 'companyId']);
      allow delete: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // ===== SEEKER PROFILES =====
    match /seekerProfiles/{userId} {
      // Employers/admins can read profiles (for talent search / candidate review).
      // A seeker who explicitly opted in (isPortfolioPublic == true) is also publicly
      // readable, which is what makes /portfolio/seeker/{id} work for a signed-out
      // visitor and for the unauthenticated build-time generateStaticParams query.
      // Rules are document-level: opting in exposes the WHOLE profile document, so the
      // client-side `privacySettings` toggles are presentation only, not access control.
      allow read: if isOwner(userId) || isAdmin() || isEmployerOrOwner()
                  || resource.data.isPortfolioPublic == true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== SAVED JOBS =====
    match /savedJobs/{docId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // P0 FIX: Only admins or the notification recipient's own system events
      // Regular clients: can only create notifications FOR OTHER users if they are an employer/admin
      // (company event notifications created server-side via firestoreService are OK)
      allow create: if isAdmin() ||
        // Employer-triggered events (interview scheduled, status update) — userId must be a valid seeker
        (isAuthenticated() && isEmployerOrOwner() &&
          request.resource.data.keys().hasAll(['userId', 'type', 'title', 'message'])) ||
        // System self-notifications (e.g. welcome) — user can only create for themselves
        (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
        // RULES-1: admin-addressed alerts (business registration, new job) from any signed-in user;
        // the admin inbox reads userId == 'admin'
        (isAuthenticated() && request.resource.data.userId == 'admin' &&
          request.resource.data.keys().hasAll(['userId', 'type', 'title', 'message'])) ||
        // FIX-2: the "you have a new applicant" alert. applyToJob runs as the SEEKER and
        // addresses the employer's uid, which none of the branches above permit, so this
        // alert was denied outright. Kept last: the branches above are pure field checks,
        // and || short-circuits, so an ordinary notification never triggers the reads below.
        (isAuthenticated() && seekerAlertingOwnApplicationsCompany());
      // Only the recipient marks their own notifications as read.
      // FIX-2: the allowed key was 'isRead', but nothing in the tree writes that field —
      // createNotification writes `read: false`, markNotificationRead writes `{ read: true }`,
      // markAllNotificationsRead queries `where('read','==',false)`, NotificationContext counts
      // `!n.read`, and payment/verify writes `read`. Every mark-as-read was therefore denied and
      // the unread badge could never clear. 'isRead' is kept for any document already using it.
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt']);
      allow delete: if isAdmin();
    }

    // ===== LEADS =====
    match /leads/{leadId} {
      allow read:   if isAuthenticated() && (isCompanyOwner(resource.data.companyId) || isAdmin());
      // SEC-2: a public enquiry form is meant to be reachable without signing in, but this
      // accepted an unauthenticated write of unbounded size naming any companyId at all — an
      // open funnel into every owner's inbox. Two things are worth recording: nothing in the
      // tree creates a lead (reads, a count and an update only), so this rule currently guards
      // a feature with no client; and the field names disagree three ways — the rule wants
      // 'name', employer/leads reads 'customerName', admin/leads and lib/types read
      // 'contactName'. A hasOnly allowlist would be inventing a schema, so this bounds the
      // damage instead: the named company must exist, the free text is capped, and the document
      // cannot be padded out.
      allow create: if
        request.resource.data.keys().hasAll(['companyId', 'name', 'message']) &&
        request.resource.data.keys().size() <= 15 &&
        request.resource.data.companyId is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2000 &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));
      allow update: if isAuthenticated() && (isCompanyOwner(resource.data.companyId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ===== INTERVIEWS =====
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      // P0 FIX: Only company owners can schedule interviews; companyId ownership enforced
      allow create: if isAuthenticated() &&
        isCompanyOwner(request.resource.data.companyId) &&
        request.resource.data.keys().hasAll(['seekerId', 'companyId', 'jobId', 'date', 'time']);
      allow update: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===== SUBSCRIPTIONS =====
    match /subscriptions/{subId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== SERVICES =====
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated() && safeJobCreate() &&
        request.resource.data.providerId == request.auth.uid;
      allow update: if
        (isAuthenticated() && resource.data.providerId == request.auth.uid && jobModerationUnchanged()) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ===== ADVERTISEMENTS =====
    match /advertisements/{adId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== ACTIVITY LOGS =====
    // SEC-2: create was open to anyone signed in, so the admin audit trail could be filled with
    // entries attributed to other people. Every one of the ten logActivity call sites passes
    // either the acting user's own uid or an admin's uid, so an entry must now name its author.
    match /activityLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===== PLATFORM SETTINGS (AI Config, etc.) =====
    match /platformSettings/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ===== JOB CHANGE HISTORY =====
    match /jobs/{jobId}/history/{historyId} {
      allow read:  if isAuthenticated() && (
        get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ===== PENDING PRODUCTS (Approval Workflow) =====
    match /pendingProducts/{productId} {
      allow read:   if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.submittedBy == request.auth.uid);
    }

    // ===== PENDING SERVICES (Approval Workflow) =====
    match /pendingServices/{serviceId} {
      allow read:   if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.submittedBy == request.auth.uid);
    }

    // ===== PORTFOLIO SITES =====
    match /portfolioSites/{siteId} {
      // RULES-5: this was `allow read: if true`, with a comment admitting that filtering by
      // status was "handled in query/client" — meaning nowhere, as far as the database is
      // concerned. A plain unauthenticated REST read against this collection, carrying only
      // the public web API key every page already ships, returned full draft content in
      // production: sections, branding, theme, seo — everything an owner had not chosen to
      // publish. PublicPortfolioPageClient.tsx checks `site.status !== 'published'` and shows
      // "currently in draft mode" instead of the content, but that check runs in the browser,
      // after the data has already left the server. Anything that is not that one component —
      // a REST call, a devtools query — read the draft anyway.
      //
      // The static export was never the exposure: generateStaticParams filters
      // status == 'published' in the query itself at build time, so no draft was ever baked
      // into a static page. The gap was purely the rule.
      //
      // A draft is now readable only by its own owner or an admin, matching the one real
      // authenticated case this app has — the owner previewing their own unpublished site.
      // There is no unauthenticated draft-preview-link feature to break; checked before
      // assuming.
      allow read: if resource.data.status == 'published' ||
        (isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /portfolioSites/{siteId}/versions/{versionId} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/portfolioSites/$(siteId)).data.ownerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        get(/databases/$(database)/documents/portfolioSites/$(siteId)).data.ownerId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ===== USERNAMES (Reservation) =====
    match /usernames/{username} {
      // RULES-6: this had `allow read: if true` and an authenticated create rule, but a
      // repository-wide search finds NO reference to this collection anywhere in src/ — no
      // read, no write, in either direction. The same shape RULES-2 found in
      // whatsappApplications and RULES-3 found in certificates/uploads: a rule block written
      // for a feature that was never built, left exactly as open as the day it was drafted
      // because nothing exercises it and nothing complains. Default-denied rather than left
      // open for a feature that does not exist; a real implementation would add a rule shaped
      // like the ones this collection's siblings already use.
      allow read, write: if false;
    }

    // ===== COUNTERS (THENIJOBS ID Generation) =====
    // SEC-2: this was read, write for any signed-in user, so any account could rewrite the
    // THENIJOBS ID sequence — reset it, or set it back so two businesses receive the same
    // registration number. The only writer is identityService.ts, whose transaction sets
    // exactly { count, updatedAt } with count = previous + 1, or count = 1 when the counter
    // does not exist yet. The rule now permits that shape and nothing else.
    match /counters/{counterId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == 1;
      allow update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // ===== CONVERSATIONS & CHAT =====
    match /conversations/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      // SEC-2: create was open to anyone signed in, so a thread could be opened naming other
      // people. applyToJob is the only creator and it always writes itself as the seeker and
      // includes itself in participants, so the rule asks for exactly that.
      allow create: if isAdmin() || (isAuthenticated() &&
        request.resource.data.seekerId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants);
      // The order of these terms is deliberate and matches what the rule did before: the
      // participants check is a field comparison and costs nothing, while isCompanyOwner() and
      // isAdmin() each spend one of the ten document reads a rule evaluation is allowed. Putting
      // isAdmin() first — which the first draft of this change did — makes every participant
      // sending a message pay for a users/ lookup, and on an account with no users document it
      // raises a null-value evaluation error rather than short-circuiting. The emulator probe
      // caught it: the denials were arriving as evaluation errors instead of clean refusals.
      allow update: if isAuthenticated() && (
        (
          (
            request.auth.uid in resource.data.participants ||
            resource.data.seekerId == request.auth.uid ||
            isCompanyOwner(resource.data.companyId)
          ) && conversationMembershipUnchanged()
        ) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /conversations/{chatId}/messages/{messageId} {
      allow read: if mayUseConversation(chatId);
      // SEC-2: create was open to anyone signed in, so a message could be posted into a thread
      // between two other people, or attributed to them. The sender must belong to the thread
      // and must sign the message as themselves. 'system' is allowed because applyToJob writes
      // the opening line of every thread with senderId: 'system'.
      allow create: if mayUseConversation(chatId) &&
        (request.resource.data.senderId == request.auth.uid ||
         request.resource.data.senderId == 'system');
      allow update, delete: if isAdmin();
    }

    // ===== JOB ALERTS =====
    match /jobAlerts/{alertId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ===== COMPANY FOLLOWS =====
    match /companyFollows/{followId} {
      // RULES-6: read was `if true` — the only user-relationship collection in this file with
      // no ownership check at all. savedJobs, jobAlerts, notifications and subscriptions all
      // gate read on `resource.data.userId == request.auth.uid`; this one let any stranger
      // learn which real user follows which real company, confirmed against the one live
      // document in production with a plain unauthenticated read. Every call site in
      // firestoreService.ts already queries by the caller's own userId, and the one UI caller
      // only runs when a uid is present, so this closes what a stranger could do without
      // changing what a signed-in user already does.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== WHATSAPP APPLICATIONS =====
    match /whatsappApplications/{docId} {
      allow read:   if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      // RULES-2: create was `isAuthenticated()` and nothing else — no ownership test and no
      // required fields, while the READ rule above keys on `seekerId` and `companyId`. So a
      // signed-in user could file an application naming ANOTHER seeker, at any company, or omit
      // both fields and leave a document only an admin could see. The keys below are exactly
      // what `trackWhatsAppApplication()` writes; `phone` is its one optional field.
      //
      // Worth knowing while reading this: nothing in src/ reads this collection, and that
      // writer currently has no callers. The rule is written to be correct if the feature is
      // wired up rather than to bless it — an unconstrained write is not worth leaving open for
      // a feature that does not exist.
      allow create: if isAuthenticated()
        && request.resource.data.seekerId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'seekerId', 'seekerName', 'jobId', 'jobTitle', 'companyId', 'appliedVia', 'createdAt'
           ])
        && request.resource.data.keys().hasOnly([
             'seekerId', 'seekerName', 'jobId', 'jobTitle', 'companyId', 'phone',
             'appliedVia', 'createdAt'
           ]);
      allow update, delete: if isAdmin();
    }

    // ===== SEO & KEYWORD ANALYTICS =====
    match /seoAnalytics/{docId} {
      // RULES-6: read was `if true` while write was already admin-only (RULES-1's own fix to
      // this same block). A repository-wide search finds no reference to this collection
      // anywhere in src/ — nothing reads it, nothing ever will have written it beyond that
      // one admin-only path, and nothing depends on the public read. Matched to the write
      // rule it already had: admin-only, not fully closed, since a genuine admin analytics
      // feature is a plausible future use for a name like this one, unlike usernames above.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== COMPANY SLUG RESERVATIONS (RULES-1, D-SLUG) =====
    // Public, write-once reservation so registration can check uniqueness without reading other
    // owners' pending companies. Fields: slug, email, ownerId, companyId, createdAt.
    match /companySlugs/{slug} {
      allow read:   if true;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['slug', 'email', 'ownerId', 'companyId', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // ===== ERROR REPORTS (RULES-1, D-ERRORS) =====
    match /errors/{errorId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['errorType', 'page', 'errorMessage', 'severity', 'status']) &&
        request.resource.data.status == 'open' &&
        request.resource.data.errorMessage is string &&
        request.resource.data.errorMessage.size() <= 2000;
    }

    // ===== PAYMENTS (RULES-1) — written only by a server identity; none exists today (D-HOSTING) =====
    match /payments/{paymentId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ===== AI USAGE LOGS (RULES-1) — written only by a server identity; none exists today (D-HOSTING) =====
    match /aiUsageLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ===== ADMIN BROADCASTS (RULES-1) =====
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ===== DEFAULT DENY (RULES-1, security.md S-1) =====
    // Firestore denies any request no block above matches. Rules are additive (OR): a permissive
    // recursive wildcard block here would override every block above it, which is exactly what
    // the previous catch-all did. Add a specific block for a new collection; never add a
    // recursive wildcard.
  }
}


