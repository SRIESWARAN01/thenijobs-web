rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isCompanyOwner(companyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isEmployerOrOwner() {
      return isAuthenticated() && getUserRole() in ['employer', 'business_owner'];
    }

    // ── Moderation field guards ───────────────────────────────────────────────
    function safeCompanyCreate() {
      let d = request.resource.data;
      return
        (!d.keys().hasAny(['verificationStatus']) || d.verificationStatus == 'pending') &&
        (!d.keys().hasAny(['isActive'])           || d.isActive == false) &&
        (!d.keys().hasAny(['isVerified'])          || d.isVerified == false) &&
        (!d.keys().hasAny(['isFeatured'])          || d.isFeatured == false) &&
        (!d.keys().hasAny(['rejectionReason'])     || d.rejectionReason == '');
    }

    function safeJobCreate() {
      let d = request.resource.data;
      return
        (!d.keys().hasAny(['status'])          || d.status == 'pending') &&
        (!d.keys().hasAny(['isActive'])         || d.isActive == false) &&
        (!d.keys().hasAny(['isFeatured'])       || d.isFeatured == false) &&
        (!d.keys().hasAny(['rejectionReason'])  || d.rejectionReason == '');
    }

    function companyModerationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'verificationStatus', 'isActive', 'isVerified', 'isFeatured',
        'isPremium', 'rejectionReason',
        // RULES-1: plan and ownership fields are admin/server-owned (security.md S-3)
        'subscriptionPlan', 'planStartDate', 'planEndDate', 'ownerId'
      ]);
    }

    function jobModerationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status', 'isActive', 'isFeatured', 'rejectionReason'
      ]);
    }

    function userModerationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isVerified', 'adminRole', 'employerRole',
        // RULES-1: credits, plan and employer-grant fields are admin/server-owned (security.md S-3)
        'aiCredits', 'aiCreditsUsed', 'companyId', 'isEmployer', 'canPostJobs',
        'subscriptionPlan', 'isPremium'
      ]);
    }

    // RULES-1 (D-JOBSTATE): a poster may deactivate their own job (pause, close) or send it back
    // for moderation (pending). Activation stays admin-only. Such a write may touch only these keys.
    function jobPosterDeactivation() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive', 'archived', 'updatedAt']) &&
        d.status in ['paused', 'closed', 'pending'] &&
        d.isActive == false;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) &&
        request.resource.data.role in ['job_seeker', 'employer', 'business_owner', 'supplier', 'service_provider']) || isAdmin();
      allow update: if (isOwner(userId) && userModerationUnchanged()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== COMPANIES =====
    match /companies/{companyId} {
      // H2 FIX: Allow public read if verified OR if isActive — aligns with frontend queries
      allow read: if resource.data.verificationStatus == 'verified' ||
        resource.data.isActive == true ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if (isAuthenticated() && safeCompanyCreate() &&
        request.resource.data.ownerId == request.auth.uid) || isAdmin();
      allow update: if
        (isAuthenticated() && resource.data.ownerId == request.auth.uid && companyModerationUnchanged()) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ===== JOBS =====
    match /jobs/{jobId} {
      // H3 FIX: Allow public read for multiple valid status values — aligns with admin workflows
      allow read: if resource.data.status in ['active', 'APPROVED', 'LIVE'] ||
        (isAuthenticated() && resource.data.postedBy == request.auth.uid) || isAdmin();
      allow create: if (isAuthenticated() && safeJobCreate() &&
        request.resource.data.postedBy == request.auth.uid) || isAdmin();
      allow update: if
        (isAuthenticated() && resource.data.postedBy == request.auth.uid &&
          (jobModerationUnchanged() || jobPosterDeactivation())) ||
        isAdmin();
      allow delete: if
        (isAuthenticated() && resource.data.postedBy == request.auth.uid) ||
        isAdmin();
    }

    // ===== JOB APPLICATIONS =====
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      // P0 FIX: seekerId must match the authenticated user — prevents impersonation
      allow create: if isAuthenticated() &&
        request.resource.data.seekerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['seekerId', 'jobId', 'companyId']);
      // Seeker can withdraw; employer (company owner) can update status
      allow update: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      ) &&
      // Seeker cannot change companyId/jobId/seekerId after submission
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seekerId', 'jobId', 'companyId']);
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.seekerId == request.auth.uid);
    }

    // ===== REVIEWS =====
    match /reviews/{reviewId} {
      allow read: if true;
      // P0 FIX: reviewerId must match authenticated user
      allow create: if isAuthenticated() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['reviewerId', 'companyId', 'rating']);
      allow update: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin()) &&
        // Cannot change companyId or reviewerId after posting
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewerId', 'companyId']);
      allow delete: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // ===== SEEKER PROFILES =====
    match /seekerProfiles/{userId} {
      // Employers/admins can read profiles (for talent search / candidate review)
      allow read: if isOwner(userId) || isAdmin() || isEmployerOrOwner();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== SAVED JOBS =====
    match /savedJobs/{docId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // P0 FIX: Only admins or the notification recipient's own system events
      // Regular clients: can only create notifications FOR OTHER users if they are an employer/admin
      // (company event notifications created server-side via firestoreService are OK)
      allow create: if isAdmin() ||
        // Employer-triggered events (interview scheduled, status update) — userId must be a valid seeker
        (isAuthenticated() && isEmployerOrOwner() &&
          request.resource.data.keys().hasAll(['userId', 'type', 'title', 'message'])) ||
        // System self-notifications (e.g. welcome) — user can only create for themselves
        (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
        // RULES-1: admin-addressed alerts (business registration, new job) from any signed-in user;
        // the admin inbox reads userId == 'admin'
        (isAuthenticated() && request.resource.data.userId == 'admin' &&
          request.resource.data.keys().hasAll(['userId', 'type', 'title', 'message']));
      // Only the recipient marks their own notifications as read
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if isAdmin();
    }

    // ===== LEADS =====
    match /leads/{leadId} {
      allow read:   if isAuthenticated() && (isCompanyOwner(resource.data.companyId) || isAdmin());
      // P0 FIX: Anyone can submit a lead (public enquiry), but companyId must be present
      allow create: if request.resource.data.keys().hasAll(['companyId', 'name', 'message']);
      allow update: if isAuthenticated() && (isCompanyOwner(resource.data.companyId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ===== INTERVIEWS =====
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      // P0 FIX: Only company owners can schedule interviews; companyId ownership enforced
      allow create: if isAuthenticated() &&
        isCompanyOwner(request.resource.data.companyId) &&
        request.resource.data.keys().hasAll(['seekerId', 'companyId', 'jobId', 'date', 'time']);
      allow update: if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===== SUBSCRIPTIONS =====
    match /subscriptions/{subId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== SERVICES =====
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated() && safeJobCreate() &&
        request.resource.data.providerId == request.auth.uid;
      allow update: if
        (isAuthenticated() && resource.data.providerId == request.auth.uid && jobModerationUnchanged()) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ===== ADVERTISEMENTS =====
    match /advertisements/{adId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== ACTIVITY LOGS =====
    match /activityLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===== PLATFORM SETTINGS (AI Config, etc.) =====
    match /platformSettings/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ===== JOB CHANGE HISTORY =====
    match /jobs/{jobId}/history/{historyId} {
      allow read:  if isAuthenticated() && (
        get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ===== PENDING PRODUCTS (Approval Workflow) =====
    match /pendingProducts/{productId} {
      allow read:   if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.submittedBy == request.auth.uid);
    }

    // ===== PENDING SERVICES (Approval Workflow) =====
    match /pendingServices/{serviceId} {
      allow read:   if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.submittedBy == request.auth.uid);
    }

    // ===== PORTFOLIO SITES =====
    match /portfolioSites/{siteId} {
      allow read: if true; // Public site viewing (filtering by status handled in query/client)
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /portfolioSites/{siteId}/versions/{versionId} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/portfolioSites/$(siteId)).data.ownerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        get(/databases/$(database)/documents/portfolioSites/$(siteId)).data.ownerId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ===== USERNAMES (Reservation) =====
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ===== COUNTERS (THENIJOBS ID Generation) =====
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // ===== CONVERSATIONS & CHAT =====
    match /conversations/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /conversations/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participants ||
        get(/databases/$(database)/documents/conversations/$(chatId)).data.seekerId == request.auth.uid ||
        isCompanyOwner(get(/databases/$(database)/documents/conversations/$(chatId)).data.companyId) ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ===== JOB ALERTS =====
    match /jobAlerts/{alertId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ===== COMPANY FOLLOWS =====
    match /companyFollows/{followId} {
      allow read:   if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== WHATSAPP APPLICATIONS =====
    match /whatsappApplications/{docId} {
      allow read:   if isAuthenticated() && (
        resource.data.seekerId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ===== SEO & KEYWORD ANALYTICS =====
    match /seoAnalytics/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();   // RULES-1: was any authenticated user (security.md S-12)
    }

    // ===== COMPANY SLUG RESERVATIONS (RULES-1, D-SLUG) =====
    // Public, write-once reservation so registration can check uniqueness without reading other
    // owners' pending companies. Fields: slug, email, ownerId, companyId, createdAt.
    match /companySlugs/{slug} {
      allow read:   if true;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['slug', 'email', 'ownerId', 'companyId', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // ===== ERROR REPORTS (RULES-1, D-ERRORS) =====
    match /errors/{errorId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['errorType', 'page', 'errorMessage', 'severity', 'status']) &&
        request.resource.data.status == 'open' &&
        request.resource.data.errorMessage is string &&
        request.resource.data.errorMessage.size() <= 2000;
    }

    // ===== PAYMENTS (RULES-1) — written only by a server identity; none exists today (D-HOSTING) =====
    match /payments/{paymentId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ===== AI USAGE LOGS (RULES-1) — written only by a server identity; none exists today (D-HOSTING) =====
    match /aiUsageLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ===== ADMIN BROADCASTS (RULES-1) =====
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ===== DEFAULT DENY (RULES-1, security.md S-1) =====
    // Firestore denies any request no block above matches. Rules are additive (OR): a permissive
    // recursive wildcard block here would override every block above it, which is exactly what
    // the previous catch-all did. Add a specific block for a new collection; never add a
    // recursive wildcard.
  }
}


